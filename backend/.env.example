# Server
PORT=8080

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/strathcona

# Auth
JWT_SECRET=your-secret-key-min-32-chars-long
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Novu (self-hosted)
NOVU_API_KEY=your-novu-api-key
NOVU_API_URL=http://novu-api:3000
NOVU_APP_ID=your-novu-app-id

# Gotenberg
GOTENBERG_URL=http://localhost:3000

# Chatwoot
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=

# QuickBooks
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=

# Anthropic AI (for Chatwoot AI responses)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_RESPONSE_ENABLED=false

# Hostaway
HOSTAWAY_BASE_URL=https://api.hostaway.com/v1
HOSTAWAY_API_KEY=
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_WEBHOOK_SECRET=
