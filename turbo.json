{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "HOSTAWAY_API_KEY",
    "HOSTAWAY_ACCOUNT_ID",
    "HOSTAWAY_CHECKOUT_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
